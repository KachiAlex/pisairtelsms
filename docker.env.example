# =============================================================================
# Pisairtel SMS — Docker Environment Variables
# Copy to .env and adjust values before deploying
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=PisairtelSMS2024!

# JWT Secret (must be at least 32 characters)
JWT_SECRET=pisairtel-sms-jwt-secret-key-2024-very-secure-32chars

# App URL (used for CORS, redirects, etc.)
APP_URL=http://162.35.104.28

# Neon source database (for migration script only — not used at runtime)
NEON_DATABASE_URL=

# Cloudflare RealtimeKit — live virtual classes
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# Permissions: Account → Realtime → Edit. Account resources: your account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_REALTIME_HOST_PRESET=host
CLOUDFLARE_REALTIME_PARTICIPANT_PRESET=participant
