// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Core Models
// ============================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                 User[]
  questionsBank         QuestionBank[]
  exams                 Exam[]
  studentExamProgress   StudentExamProgress[]
  examResults           ExamResult[]
  securitySettings      SecuritySettings[]
  proctoringLogs        ProctoringLog[]
  auditLogs             AuditLog[]
  offlineSyncQueue      OfflineSyncQueue[]
  absenceReasons        AbsenceReason[]
  biometricDevices      BiometricDevice[]
  attendanceRecords     AttendanceRecord[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String
  role      String   // 'admin', 'invigilator', 'student', 'teacher'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Relations
  createdQuestions      QuestionBank[] @relation("CreatedBy")
  createdExams          Exam[] @relation("CreatedBy")
  studentExamProgress   StudentExamProgress[]
  examResults           ExamResult[]
  studentAnswers        StudentAnswer[]
  proctoringLogs        ProctoringLog[]
  auditLogs             AuditLog[]
  offlineSyncQueue      OfflineSyncQueue[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ============================================================================
// Question Bank Models
// ============================================================================

model QuestionBank {
  id            String   @id @default(cuid())
  tenantId      String
  text          String   @db.Text
  type          String   // 'objective', 'truefalse', 'essay'
  options       Json?    // Array of options for objective/truefalse
  correctAnswer String?
  difficulty    String   // 'Easy', 'Medium', 'Hard'
  subject       String
  tags          Json     @default("[]") // Array of tags
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  creator User @relation("CreatedBy", fields: [createdBy], references: [id])

  // Relations
  examQuestions ExamQuestion[]
  studentAnswers StudentAnswer[]

  @@index([tenantId])
  @@index([subject])
  @@index([difficulty])
  @@index([createdAt])
  @@map("questions_bank")
}

// ============================================================================
// Exam Models
// ============================================================================

model Exam {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  subject         String
  class           String
  description     String?  @db.Text
  duration        Int      // in minutes
  passMark        Decimal  @db.Decimal(5, 2)
  totalMarks      Decimal  @db.Decimal(5, 2)
  status          String   @default("Draft") // 'Draft', 'Scheduled', 'Ongoing', 'Completed'
  scheduledDate   DateTime?
  scheduledTime   String?  // HH:MM format
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  creator User @relation("CreatedBy", fields: [createdBy], references: [id])

  // Relations
  examQuestions       ExamQuestion[]
  studentExamProgress StudentExamProgress[]
  examResults         ExamResult[]
  securitySettings    SecuritySettings?
  proctoringLogs      ProctoringLog[]
  offlineSyncQueue    OfflineSyncQueue[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("exams")
}

model ExamQuestion {
  id              String   @id @default(cuid())
  examId          String
  questionId      String
  questionOrder   Int
  marks           Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question QuestionBank @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
  @@map("exam_questions")
}

// ============================================================================
// Student Progress & Results Models
// ============================================================================

model StudentExamProgress {
  id                String   @id @default(cuid())
  examId            String
  studentId         String
  questionsAnswered Int      @default(0)
  currentQuestion   Int      @default(0)
  status            String   @default("Active") // 'Active', 'Paused', 'Completed', 'Flagged'
  timeRemaining     Int?     // in seconds
  lastActivityTime  DateTime @default(now())
  flagReason        String?
  flaggedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id])
  student User @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([status])
  @@map("student_exam_progress")
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  score         Decimal  @db.Decimal(5, 2)
  totalMarks    Decimal  @db.Decimal(5, 2)
  percentage    Decimal  @db.Decimal(5, 2)
  status        String   // 'Passed', 'Failed'
  timeSpent     Int      // in seconds
  submittedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id])
  student User @relation(fields: [studentId], references: [id])
  studentAnswers StudentAnswer[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([createdAt])
  @@map("exam_results")
}

model StudentAnswer {
  id            String   @id @default(cuid())
  resultId      String
  questionId    String
  studentAnswer String?  @db.Text
  correctAnswer String?
  isCorrect     Boolean
  marksObtained Decimal  @db.Decimal(5, 2)
  totalMarks    Decimal  @db.Decimal(5, 2)
  createdAt     DateTime @default(now())

  result ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question QuestionBank @relation(fields: [questionId], references: [id])

  @@index([resultId])
  @@index([questionId])
  @@map("student_answers")
}

// ============================================================================
// Security Models
// ============================================================================

model SecuritySettings {
  id                    String   @id @default(cuid())
  examId                String   @unique
  enableProctoring      Boolean  @default(false)
  disableCopyPaste      Boolean  @default(false)
  disableRightClick     Boolean  @default(false)
  requireCamera         Boolean  @default(false)
  randomizeQuestions    Boolean  @default(false)
  randomizeOptions      Boolean  @default(false)
  allowedIps            Json     @default("[]") // Array of IP addresses/CIDR
  examPassword          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("security_settings")
}

model ProctoringLog {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  eventType     String   // 'tab_switch', 'copy_attempt', 'camera_off', 'suspicious_activity', etc.
  eventDetails  Json?
  createdAt     DateTime @default(now())

  exam Exam @relation(fields: [examId], references: [id])
  student User @relation(fields: [studentId], references: [id])

  @@index([examId])
  @@index([studentId])
  @@index([createdAt])
  @@map("proctoring_logs")
}

// ============================================================================
// Audit & Logging Models
// ============================================================================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  action      String   // 'create', 'update', 'delete', 'flag', 'approve', etc.
  entityType  String   // 'question', 'exam', 'result', 'security_settings', etc.
  entityId    String?
  changes     Json?    // Before/after values
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType])
  @@map("audit_logs")
}

// ============================================================================
// Offline Sync Models
// ============================================================================

model OfflineSyncQueue {
  id          String   @id @default(cuid())
  studentId   String
  examId      String
  answers     Json     // Array of answers to sync
  syncStatus  String   @default("pending") // 'pending', 'synced', 'failed'
  createdAt   DateTime @default(now())
  syncedAt    DateTime?

  student User @relation(fields: [studentId], references: [id])
  exam Exam @relation(fields: [examId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@index([studentId])
  @@index([examId])
  @@index([syncStatus])
  @@index([createdAt])
  @@map("offline_sync_queue")
}

// ============================================================================
// Attendance Logging System Models
// ============================================================================

model AbsenceReason {
  id          String   @id @default(cuid())
  tenantId    String
  reasonName  String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@unique([tenantId, reasonName])
  @@index([tenantId])
  @@index([isActive])
  @@map("absence_reasons")
}

model BiometricDevice {
  id                    String   @id @default(cuid())
  tenantId              String
  deviceName            String   @db.VarChar(255)
  deviceType            String   @db.VarChar(50) // 'fingerprint', 'face', 'iris', 'palm'
  manufacturer          String?  @db.VarChar(255)
  model                 String?  @db.VarChar(255)
  serialNumber          String?  @unique @db.VarChar(255)
  location              String?  @db.VarChar(255)
  status                String   @default("inactive") @db.VarChar(50) // 'active', 'inactive', 'maintenance', 'error'
  syncStatus            String   @default("pending") @db.VarChar(50) // 'synced', 'pending', 'failed'
  ipAddress             String?  @db.VarChar(45)
  port                  Int?
  connectionProtocol    String   @default("HTTPS") @db.VarChar(50)
  syncFrequency         String   @default("daily") @db.VarChar(50) // 'hourly', 'every_4_hours', 'daily', 'manual'
  lastSync              DateTime?
  lastError             String?  @db.Text
  consecutiveFailures   Int      @default(0)
  enrolledStudentsCount Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  deviceEnrollments DeviceEnrollment[]
  deviceSyncLogs    DeviceSyncLog[]

  @@index([tenantId])
  @@index([status])
  @@index([syncStatus])
  @@index([serialNumber])
  @@map("biometric_devices")
}

model AttendanceRecord {
  id                String   @id @default(cuid())
  tenantId          String
  studentId         String   @db.VarChar(50)
  class             String   @db.VarChar(50)
  date              DateTime @db.Date
  status            String   @db.VarChar(20) // 'present', 'absent', 'late'
  absenceReasonId   String?
  source            String   @db.VarChar(50) // 'teacher_entry', 'biometric_device', 'batch_upload', 'api_entry'
  deviceId          String?
  userId            String?
  academicSession   String   @db.VarChar(20)
  term              String   @db.VarChar(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  absenceReason AbsenceReason? @relation(fields: [absenceReasonId], references: [id], onDelete: SetNull)
  device BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  auditTrail AttendanceAuditTrail[]

  @@unique([tenantId, studentId, date])
  @@index([studentId, date])
  @@index([class, date])
  @@index([deviceId])
  @@index([source])
  @@index([tenantId])
  @@index([status])
  @@index([academicSession])
  @@index([term])
  @@index([date])
  @@map("attendance_records")
}

model AttendanceAuditTrail {
  id                  String   @id @default(cuid())
  attendanceRecordId  String
  action              String   @db.VarChar(50) // 'create', 'update', 'delete'
  oldValue            Json?
  newValue            Json?
  changedBy           String
  changedAt           DateTime @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId])
  @@index([changedAt])
  @@index([action])
  @@index([changedBy])
  @@map("attendance_audit_trail")
}

model DeviceEnrollment {
  id          String   @id @default(cuid())
  deviceId    String
  studentId   String   @db.VarChar(50)
  biometricId String   @db.VarChar(255)
  enrolledAt  DateTime @default(now())

  device BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, studentId])
  @@unique([deviceId, biometricId])
  @@index([deviceId])
  @@index([studentId])
  @@index([biometricId])
  @@map("device_enrollment")
}

model DeviceSyncLog {
  id              String   @id @default(cuid())
  deviceId        String
  syncTimestamp   DateTime @default(now())
  status          String   @db.VarChar(50) // 'success', 'failed', 'partial'
  recordsSynced   Int      @default(0)
  recordsFailed   Int      @default(0)
  errorDetails    String?  @db.Text
  syncDurationMs  Int?

  device BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([syncTimestamp])
  @@index([status])
  @@map("device_sync_logs")
}

// ============================================================================
// Fee Management Models
// ============================================================================

model FeeAssignment {
  id              String   @id @default(cuid())
  studentId       String
  feeStructureId  String
  academicSession String
  term            String
  totalAmount     Decimal  @db.Decimal(12, 2)
  totalPaid       Decimal  @db.Decimal(12, 2) @default(0)
  totalBalance    Decimal  @db.Decimal(12, 2)
  status          String   @default("pending") // 'pending', 'partial', 'paid'
  dueDate         DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([feeStructureId])
  @@index([academicSession, term])
  @@map("fee_assignments")
}

model Exemption {
  id              String   @id @default(cuid())
  studentId       String
  feeAssignmentId String
  exemptionType   String
  amount          Decimal? @db.Decimal(12, 2)
  percentage      Decimal? @db.Decimal(5, 2)
  reason          String
  approvedBy      String
  approvalDate    DateTime @default(now())
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())

  @@index([studentId])
  @@index([feeAssignmentId])
  @@map("exemptions")
}

model StudentPayment {
  id              String   @id @default(cuid())
  studentId       String
  feeStructureId  String
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   // 'cash', 'bank_transfer', 'card', 'pos'
  reference       String?
  receiptUrl      String?
  paidAt          DateTime @default(now())
  recordedBy      String?
  notes           String?

  @@index([studentId])
  @@index([feeStructureId])
  @@index([paidAt])
  @@map("student_payments")
}
